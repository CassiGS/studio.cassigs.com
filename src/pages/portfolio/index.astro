---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoPage from "../../components/SeoPage.astro";

const entries = await getCollection("portfolio");

const allImages = import.meta.glob<{ default: ImageMetadata }>(
  "../../content/posts/**/*.{jpg,jpeg,JPG,JPEG,png,PNG}",
  { eager: true }
);

function resolveImage(featureImage: string): ImageMetadata | undefined {
  // featureImage is stored relative to src/content/portfolio/ (e.g. "../posts/foo/bar.jpg")
  // glob keys are relative to this file at src/pages/portfolio/
  const key = featureImage.replace("../posts/", "../../content/posts/");
  return allImages[key]?.default;
}
---

<BaseLayout>
  <SeoPage slot="head" title="Portfolio | CassiGS Studio" />
  <h1>Portfolio</h1>
  <div class="grid">
    {entries.map((entry) => {
      const img = entry.data.featureImage ? resolveImage(entry.data.featureImage) : undefined;
      return (
        <a href={`/portfolio/${entry.id}`}>
          {img && <Image src={img} alt={entry.data.title} />}
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  .grid {
    columns: 2;
    column-gap: 1rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) {
    .grid {
      columns: 3;
    }
  }
  .grid a {
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
  }
  .grid img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
