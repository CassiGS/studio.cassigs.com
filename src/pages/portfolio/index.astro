---

import BaseLayout from "../../layouts/BaseLayout.astro";
import SeoPage from "../../components/SeoPage.astro";

import { getCollection } from "astro:content";
const entries = await getCollection("portfolio");

---

<BaseLayout>
  <SeoPage slot="head" title="Portfolio | CassiGS Studio" />
  <h1>Portfolio</h1>
  <div class="grid">
    {entries.map((entry) => (
     <p>{entry.data.title} </p>
    ))}
  </div>
</BaseLayout>

<style>
  .grid {
    columns: 2;
    column-gap: 1rem;
    margin-top: 1.5rem;
  }
  .grid a {
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
  }
  .grid img {
    width: 100%;
    height: auto;
    display: block;
  }
</style>
