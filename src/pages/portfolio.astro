---
import BaseLayout from "../layouts/BaseLayout.astro";
import SeoPage from "../components/SeoPage.astro";
---

<BaseLayout>
  <SeoPage slot="head" title="Portfolio | CassiGS Studio" />
  <h1>Portfolio</h1>
  <div class="grid">
    <img src="https://placehold.co/600x400/EEE/31343C" alt="" />
    <img src="https://placehold.co/400x600/EEE/31343C" alt="" />
    <img src="https://placehold.co/600x400/EEE/31343C" alt="" />
    <img src="https://placehold.co/400x600/EEE/31343C" alt="" />
    <img src="https://placehold.co/600x400/EEE/31343C" alt="" />
    <img src="https://placehold.co/400x600/EEE/31343C" alt="" />
  </div>
</BaseLayout>

<style>
  .grid {
    columns: 2;
    column-gap: 1rem;
    margin-top: 1.5rem;
  }
  .grid img {
    width: 100%;
    height: auto;
    display: block;
    margin-bottom: 1rem;
    break-inside: avoid;
  }
</style>
