---
import { CONTACT } from "../siteConfig";

import ExternalLink from "./ExternalLink.astro";
---

<section>
  <div class="prose dark:prose-invert prose-neutral section-heading">
    <h2>Contact</h2>
  </div>
  <ul class="social-list">
    {
      Object.values(CONTACT).map((contact) => {
        return (
          <ExternalLink href={contact.href}>{contact.label}</ExternalLink>
        );
      })
    }
  </ul>
</section>

<style>
  .section-heading {
    margin-bottom: 0.75rem;
  }
  .social-list {
    display: grid;
    list-style: none;
    gap: 1rem;
    padding: 0;
    margin: 0;
  }
</style>
