---
interface Props {
  title: string;
  summary: string;
  year: number | string;
}

const { title, summary, year, blogLink, client, medium } = Astro.props;
---

<aside>
  <div class="left">
    <h1>{title}</h1>
    <p>{summary}</p>
    <a href={blogLink} class="link">Read Blog Post</a>
  </div>
  <div class="right">
    <ul>
    <li><span>Client:</span> {client}</li>
    <li><span>Year:</span> {year}</li>
     <li><span>Medium:</span> {medium}</li>
    </ul>
  </div>
</aside>

<style>
  aside {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 1rem;
    background: #f2f2f2;
    padding: 1rem;
    margin-bottom: 2rem;
    margin-top: 1rem;
  }
  :global(.dark) aside {
    background: #222;
  }
  .left h1 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }
  .left p {
    margin: 0;
  }
  .right {
    display: flex;
    align-items: flex-start;
    white-space: nowrap;
  }
  a {
    margin-top: 1rem;
    display: block;
    }

  li {
    font-size: .9rem;
  }

  li span {
    text-transform: uppercase;
    font-weight: 600;
  }
</style>
